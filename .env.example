APP_NAME=Ideas Studio
APP_ENV=development
APP_URL=http://localhost:8000
# Production example:
# APP_ENV=production
# APP_URL=https://your-app.up.railway.app
# FRONTEND_URL=https://ideas-studio-six.vercel.app
# CORS_ORIGINS=https://ideas-studio-six.vercel.app

# PostgreSQL uniquement (schéma v3 : schémas nommés, RLS, jsonb, ENUM natifs,
# partitionnement). SQLite n'est plus supporté, sauf en APP_ENV=test.
DATABASE_URL=postgresql://user:password@host:5432/ideas_studio

SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

IDEAS_PER_DAY=1

# ── LLM Provider ──────────────────────────────────────────────────────────
# Pour utiliser gratuitement sans limite API cloud :
#   1. installer Ollama  →  https://ollama.com
#   2. lancer :           ollama pull qwen3:14b
#   3. fallback :         ollama pull qwen3:8b
#   4. démarrer :         DEFAULT_LLM_PROVIDER=ollama
# Options : auto (try OpenRouter > Ollama > OpenAI), ollama, openai, openrouter, gemini, mock
# Les providers réellement utilisés par les projets (clé API, modèle) se
# configurent en base via Paramètres → Providers, pas ici — ces variables ne
# servent que de repli par défaut / pour le développement local sans DB.
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_SEARCH_PROVIDER=mock

# ── Pipeline éditorial ────────────────────────────────────────────────────
# OUTLINE_PLANNER_MODE : plan d'article généré par LLM (llm, défaut) ou par
# heuristique/patrons (heuristic, plus rapide, zéro coût).
OUTLINE_PLANNER_MODE=llm

# ── Ollama (LLM local ou cloud) ───────────────────────────────────────────
# Local et gratuit par défaut. Peut aussi pointer vers Ollama Cloud
# (https://ollama.com) en configurant une clé API dans Paramètres → Providers.
# qwen3:14b pour machine 16Go+, qwen3:8b pour machine 8Go+, qwen3:30b pour machine 32Go+
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_FALLBACK_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=180

# ── OpenAI (payant) ───────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Gemini API (gratuit avec quota, officiel Google) ─────────────────────
# Obtiens ta clé : https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_TIMEOUT_SECONDS=180

# ── OpenRouter (gratuit si modèle ":free") ────────────────────────────────
# Obtiens ta clé : https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash:free
OPENROUTER_WRITER_MODEL=deepseek/deepseek-v4-flash:free
OPENROUTER_PLANNER_MODEL=openai/gpt-oss-120b:free
OPENROUTER_FALLBACK_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Recherche web (génération d'idées + analyse concurrentielle) ──────────
# IMPORTANT : sans l'une de ces options, la génération d'idées tourne sur
# des résultats INVENTÉS (MockSearchProvider) — aucune vraie recherche web
# n'a lieu, sans avertissement visible ailleurs que les logs.
# Détection automatique dès qu'une des clés ci-dessous est renseignée
# (pas besoin de changer DEFAULT_SEARCH_PROVIDER en plus). Priorité si
# plusieurs sont configurées : Brave > Google > SearXNG.
#
# Option A — Brave Search API (recommandé) : crédit gratuit mensuel puis
# facturation à l'usage très faible (~0.003-0.005$/requête).
#   https://api-dashboard.search.brave.com/
BRAVE_SEARCH_API_KEY=
#
# Option B — Google Custom Search JSON API : NE PLUS UTILISER pour un
# nouveau moteur — Google a déprécié la recherche "sur l'ensemble du web"
# pour les moteurs personnalisés créés après cette dépréciation, ce qui
# renvoie un 403 permanent quelle que soit la config du projet Google
# Cloud (API activée, facturation activée, cx dans le bon projet : rien
# n'y change). Gardé en repli pour un cx pré-existant qui fonctionne déjà.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
#
# Option C — SearXNG auto-hébergé (illimité, nécessite un serveur/VPS) :
#   https://github.com/searxng/searxng-docker
SEARXNG_URL=
SEARXNG_FORMAT=json
#
# ── Analyse concurrentielle SERP (agent search_serp, indépendant de ce qui précède) ──
SERP_API_KEY=
#
# ── Images (planification + insertion automatique dans les articles) ─────
UNSPLASH_ACCESS_KEY=

# ── Publication rapide (revalidation site public) ─────────────────────────
# Repli global si un projet n'a pas encore son propre secret (généré
# automatiquement dans Paramètres → Intégration à la connexion du site).
BLOG_REVALIDATE_URL=
BLOG_REVALIDATE_SECRET=

# ── Supabase Storage — stockage permanent des médias (sinon disque local) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ideas-media

# ── Google Analytics 4 (page Performance / Traffic) ───────────────────────
GA4_PROPERTY_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
